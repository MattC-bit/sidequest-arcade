{
  "manifest_version": 3,
  "name": "SideQuest • Waiting Arcade",
  "version": "1.2.0",
  "description": "Play a short arcade game in your ChatGPT tab while a reply is on its way.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_title": "SideQuest arcade",
    "default_popup": "toolbar.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "host.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "arcade.html"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
